# Tether configuration
# Copy to .env and edit values

# Server
PORT=7374
PHX_HOST=localhost
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret

# Optional: Auth token (auto-generated if not set)
# TETHER_TOKEN=your-secret-token

# Optional: TLS (e.g., from `tailscale cert <hostname>`)
# TLS_CERTFILE=priv/cert/your-host.crt
# TLS_KEYFILE=priv/cert/your-host.key

# Optional: Push notifications
# Generate keys with: Tether.Notifier.generate_vapid_keys() in iex
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
