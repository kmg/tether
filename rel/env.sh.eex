#!/bin/sh

# Ensure Homebrew binaries (tmux, openssl) are on PATH
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Data directory for persistent state (subscriptions, tokens, secrets)
export TETHER_DATA_DIR="${TETHER_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tether}"
mkdir -p "$TETHER_DATA_DIR"

# Source user config if present (TLS_CERTFILE, TLS_KEYFILE, PHX_HOST, etc.)
if [ -f "$TETHER_DATA_DIR/env" ]; then
  set -a
  . "$TETHER_DATA_DIR/env"
  set +a
fi

# Auto-generate SECRET_KEY_BASE on first run
if [ -z "$SECRET_KEY_BASE" ]; then
  SECRET_FILE="$TETHER_DATA_DIR/.secret_key_base"
  if [ ! -f "$SECRET_FILE" ]; then
    openssl rand -base64 48 > "$SECRET_FILE"
    chmod 600 "$SECRET_FILE"
  fi
  export SECRET_KEY_BASE="$(cat "$SECRET_FILE")"
fi

# Auto-generate TETHER_TOKEN on first run
if [ -z "$TETHER_TOKEN" ]; then
  TOKEN_FILE="$TETHER_DATA_DIR/.token"
  if [ ! -f "$TOKEN_FILE" ]; then
    openssl rand -base64 24 | tr '+/' '-_' | tr -d '=\n' > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
  fi
  export TETHER_TOKEN="$(cat "$TOKEN_FILE")"
fi

# Defaults
export PORT="${PORT:-7374}"
export PHX_HOST="${PHX_HOST:-localhost}"

# Print access URL on start (not on eval/rpc commands)
case "$1" in
  start|daemon)
    if [ -n "$TLS_CERTFILE" ] && [ -f "$TLS_CERTFILE" ]; then
      SCHEME="https"
    else
      SCHEME="http"
    fi
    echo ""
    echo "Tether running at ${SCHEME}://${PHX_HOST}:${PORT}?token=${TETHER_TOKEN}"
    echo ""
    echo "Data directory: $TETHER_DATA_DIR"
    echo ""
    ;;
esac
